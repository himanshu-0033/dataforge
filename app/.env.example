# Copy to .env, keep all credentials on the API/worker host. Never use VITE_ for secrets.
API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:5173
# Generate a long shared worker-to-API secret. Required for live mode.
WORKER_SECRET=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Paid Vertex Gemini conversation. Decode credentials only in server memory.
COUNSELOR_PROVIDER=vertex
GOOGLE_CREDENTIALS_BASE64=
# Optional when the service account JSON already contains the project ID.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.1-pro-preview
VERTEX_THINKING_LEVEL=MEDIUM
# Fast voice replies use the same conversation and safety instructions.
VERTEX_VOICE_MODEL=gemini-3-flash-preview
VERTEX_VOICE_THINKING_LEVEL=MINIMAL
# If no text arrives, race one extra same-provider request; first response wins.
VERTEX_VOICE_RETRY_DELAY=3.5
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS or managed Application Default Credentials.
# Groq remains an explicit alternative: set COUNSELOR_PROVIDER=groq.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
RIME_API_KEY=
RIME_MODEL=coda
RIME_SPEAKER=hesse
RIME_LANGUAGE=en
RIME_SAMPLE_RATE=24000
# Base host only: installed official plugin appends /ws3.
RIME_BASE_URL=wss://users-ws.rime.ai
