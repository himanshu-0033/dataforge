# Copy to .env, keep all credentials on the API/worker host. Never use VITE_ for secrets.
APP_MODE=fixture
DEMO_ENABLED=true
DATABASE_PATH=data/pickmate.sqlite
API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:5173
# Generate a long shared worker-to-API secret. Required for live mode.
WORKER_SECRET=3I4aShazvfx3TWZyfB0X7QIi41UMsAxobAtEoUUJxtk
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini-2025-04-14
RIME_API_KEY=
RIME_MODEL=coda
RIME_SPEAKER=astra
RIME_LANGUAGE=en
RIME_SAMPLE_RATE=24000
# Base host only: installed official plugin appends /ws3.
RIME_BASE_URL=wss://users-ws.rime.ai
# US West is provisional until measured from deployed worker.
RIME_REGION=us-west-2
